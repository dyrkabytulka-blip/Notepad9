<c:N9Window x:Class="Notepad9.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="clr-namespace:Notepad9.Controls"
            xmlns:ed="clr-namespace:Notepad9.Editor"
            Title="Untitled - Notepad9" Width="1100" Height="700" MinWidth="420" MinHeight="240"
            AllowDrop="True">
    <c:N9Window.Resources>
        <ContextMenu x:Key="EditorMenu" x:Shared="False" Opened="EditorMenu_Opened">
                                        <MenuItem Header="_Undo" Tag="undo" InputGestureText="Ctrl+Z" Icon="{c:Ico undo}" Click="Cmd"/>
                                        <MenuItem Header="_Redo" Tag="redo" InputGestureText="Ctrl+Y" Icon="{c:Ico redo}" Click="Cmd"/>
                                        <Separator/>
                                        <MenuItem Header="Cu_t" Tag="cut" InputGestureText="Ctrl+X" Icon="{c:Ico cut}" Click="Cmd"/>
                                        <MenuItem Header="_Copy" Tag="copy" InputGestureText="Ctrl+C" Icon="{c:Ico copy}" Click="Cmd"/>
                                        <MenuItem Header="_Paste" Tag="paste" InputGestureText="Ctrl+V" Icon="{c:Ico paste}" Click="Cmd"/>
                                        <MenuItem Header="_Delete" Tag="delete" InputGestureText="Del" Click="Cmd"/>
                                        <Separator/>
                                        <MenuItem Header="Select _All" Tag="select_all" InputGestureText="Ctrl+A" Click="Cmd"/>
                                        <Separator/>
                                        <MenuItem Header="_Find..." Tag="find" InputGestureText="Ctrl+F" Icon="{c:Ico find}" Click="Cmd"/>
                                        <MenuItem Header="_Go To..." Tag="goto" InputGestureText="Ctrl+G" Icon="{c:Ico goto}" Click="Cmd"/>
                                    </ContextMenu>
    </c:N9Window.Resources>
    <Grid x:Name="RootGrid">
    <Border x:Name="WindowBackImage" Visibility="Collapsed" IsHitTestVisible="False"/>
    <DockPanel>
        <!-- ================================================================ menu -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="2,0,0,0">
            <MenuItem Header="_File" SubmenuOpened="Menu_Opened">
                <MenuItem Header="_New Tab" Tag="new" InputGestureText="Ctrl+T" Icon="{c:Ico new}" Click="Cmd"/>
                <MenuItem Header="New _Window" Tag="window_new" InputGestureText="Ctrl+Shift+N" Icon="{c:Ico window_new}" Click="Cmd"/>
                <MenuItem Header="_Open..." Tag="open" InputGestureText="Ctrl+O" Icon="{c:Ico open}" Click="Cmd"/>
                <MenuItem x:Name="MiReload" Header="_Reload" Tag="reload" InputGestureText="Ctrl+R" Click="Cmd"/>
                <Separator/>
                <MenuItem Header="_Close Tab" Tag="close_tab" InputGestureText="Ctrl+W" Click="Cmd"/>
                <MenuItem Header="Close _All Tabs" Tag="close_all" Click="Cmd"/>
                <MenuItem x:Name="MiReopenTab" Header="Reopen Closed _Tab" Tag="reopen_tab" InputGestureText="Ctrl+Shift+T" Click="Cmd"/>
                <MenuItem Header="Save A_ll" Tag="save_all" InputGestureText="Ctrl+Alt+S" Click="Cmd"/>
                <MenuItem x:Name="MiRecent" Header="Recent _Files" Icon="{c:Ico recent}"/>
                <Separator/>
                <MenuItem x:Name="MiSave" Header="_Save" Tag="save" InputGestureText="Ctrl+S" Icon="{c:Ico save}" Click="Cmd"/>
                <MenuItem Header="Save _As..." Tag="save_as" InputGestureText="F12" Icon="{c:Ico save_as}" Click="Cmd"/>
                <MenuItem Header="Save _Copy..." Tag="save_copy" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiEncoding" Header="_Encoding"/>
                <MenuItem x:Name="MiEol" Header="_Line Endings"/>
                <Separator/>
                <MenuItem x:Name="MiFavorites" Header="Fa_vorites" Icon="{c:Ico star}"/>
                <MenuItem x:Name="MiAddFav" Header="A_dd to Favorites" Tag="star_add" Icon="{c:Ico star_add}" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiOpenFolder" Header="Open Containing _Folder" Tag="open_folder" Click="Cmd"/>
                <MenuItem x:Name="MiRun" Header="R_un" Tag="run" InputGestureText="F5" Icon="{c:Ico run}" Click="Cmd"/>
                <MenuItem Header="_Console" Tag="console" InputGestureText="Ctrl+`" Icon="{c:Ico terminal}" Click="Cmd"/>
                <MenuItem Header="External Command _Prompt" Tag="terminal_ext" Click="Cmd"/>
                <Separator/>
                <MenuItem Header="_Print..." Tag="print" InputGestureText="Ctrl+P" Icon="{c:Ico print}" Click="Cmd"/>
                <Separator/>
                <MenuItem Header="E_xit" Tag="exit" InputGestureText="Ctrl+Q" Icon="{c:Ico exit}" Click="Cmd"/>
                <MenuItem x:Name="MiQuit" Header="_Quit Completely (stop background)" Tag="quit" InputGestureText="Ctrl+Shift+Q" Click="Cmd"/>
            </MenuItem>
            <MenuItem Header="_Edit" SubmenuOpened="Menu_Opened">
                <MenuItem x:Name="MiUndo" Header="_Undo" Tag="undo" InputGestureText="Ctrl+Z" Icon="{c:Ico undo}" Click="Cmd"/>
                <MenuItem x:Name="MiRedo" Header="_Redo" Tag="redo" InputGestureText="Ctrl+Y" Icon="{c:Ico redo}" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiCut" Header="Cu_t" Tag="cut" InputGestureText="Ctrl+X" Icon="{c:Ico cut}" Click="Cmd"/>
                <MenuItem x:Name="MiCopy" Header="_Copy" Tag="copy" InputGestureText="Ctrl+C" Icon="{c:Ico copy}" Click="Cmd"/>
                <MenuItem x:Name="MiPaste" Header="_Paste" Tag="paste" InputGestureText="Ctrl+V" Icon="{c:Ico paste}" Click="Cmd"/>
                <MenuItem x:Name="MiDelete" Header="_Delete" Tag="delete" InputGestureText="Del" Click="Cmd"/>
                <Separator/>
                <MenuItem Header="Select _All" Tag="select_all" InputGestureText="Ctrl+A" Click="Cmd"/>
                <Separator/>
                <MenuItem Header="_Lines">
                    <MenuItem Header="_Duplicate Line" Tag="dup_line" InputGestureText="Ctrl+D" Click="Cmd"/>
                    <MenuItem Header="De_lete Line" Tag="del_line" InputGestureText="Ctrl+Shift+D" Click="Cmd"/>
                    <MenuItem Header="Move Line _Up" Tag="line_up" InputGestureText="Alt+Up" Click="Cmd"/>
                    <MenuItem Header="Move Line Do_wn" Tag="line_down" InputGestureText="Alt+Down" Click="Cmd"/>
                    <Separator/>
                    <MenuItem Header="Sort _Ascending" Tag="sort_asc" Click="Cmd"/>
                    <MenuItem Header="Sort D_escending" Tag="sort_desc" Click="Cmd"/>
                    <MenuItem Header="Remove Du_plicate Lines" Tag="uniq" Click="Cmd"/>
                    <MenuItem Header="Remove _Empty Lines" Tag="no_empty" Click="Cmd"/>
                    <MenuItem Header="_Join Lines" Tag="join" Click="Cmd"/>
                </MenuItem>
                <MenuItem Header="C_onvert">
                    <MenuItem Header="_UPPERCASE" Tag="upper" InputGestureText="Ctrl+Shift+U" Click="Cmd"/>
                    <MenuItem Header="_lowercase" Tag="lower" InputGestureText="Ctrl+U" Click="Cmd"/>
                    <MenuItem Header="_Title Case" Tag="title" Click="Cmd"/>
                    <MenuItem Header="_iNVERT cASE" Tag="invert" Click="Cmd"/>
                    <Separator/>
                    <MenuItem Header="Tabs to _Spaces" Tag="tabs2spaces" Click="Cmd"/>
                    <MenuItem Header="Leading Spaces to T_abs" Tag="spaces2tabs" Click="Cmd"/>
                    <MenuItem Header="T_rim Trailing Whitespace" Tag="trim" Click="Cmd"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Insert Date/_Time" Tag="datetime" InputGestureText="Ctrl+F5" Click="Cmd"/>
                <MenuItem Header="Complete _Word" Tag="complete" InputGestureText="Ctrl+Space" Icon="{c:Ico ac_word}" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiMarkdown" Header="_Markdown">
                    <MenuItem Header="_Bold" Tag="md_bold" InputGestureText="Ctrl+B" Icon="{c:Ico md_bold}" Click="Cmd"/>
                    <MenuItem Header="_Italic" Tag="md_italic" InputGestureText="Ctrl+I" Icon="{c:Ico md_italic}" Click="Cmd"/>
                    <MenuItem Header="_Strikethrough" Tag="md_strike" Icon="{c:Ico md_strike}" Click="Cmd"/>
                    <MenuItem Header="_Heading" Tag="md_heading" InputGestureText="Ctrl+Shift+H" Icon="{c:Ico md_heading}" Click="Cmd"/>
                    <MenuItem Header="Inline _Code" Tag="md_code" Icon="{c:Ico md_code}" Click="Cmd"/>
                    <MenuItem Header="Code Bloc_k" Tag="md_codeblock" Icon="{c:Ico md_codeblock}" Click="Cmd"/>
                    <Separator/>
                    <MenuItem Header="_Link" Tag="md_link" InputGestureText="Ctrl+K" Icon="{c:Ico md_link}" Click="Cmd"/>
                    <MenuItem Header="I_mage..." Tag="md_image" Icon="{c:Ico md_image}" Click="Cmd"/>
                    <Separator/>
                    <MenuItem Header="B_ullet List" Tag="md_ul" Icon="{c:Ico md_ul}" Click="Cmd"/>
                    <MenuItem Header="_Numbered List" Tag="md_ol" Icon="{c:Ico md_ol}" Click="Cmd"/>
                    <MenuItem Header="_Task List" Tag="md_task" Icon="{c:Ico md_task}" Click="Cmd"/>
                    <MenuItem Header="_Quote" Tag="md_quote" Icon="{c:Ico md_quote}" Click="Cmd"/>
                    <MenuItem Header="T_able" Tag="md_table" Icon="{c:Ico md_table}" Click="Cmd"/>
                    <MenuItem Header="Horizontal _Rule" Tag="md_hr" Icon="{c:Ico md_hr}" Click="Cmd"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Sea_rch" SubmenuOpened="Menu_Opened">
                <MenuItem Header="_Find..." Tag="find" InputGestureText="Ctrl+F" Icon="{c:Ico find}" Click="Cmd"/>
                <MenuItem Header="Find _Next" Tag="find_next" InputGestureText="F3" Click="Cmd"/>
                <MenuItem Header="Find _Previous" Tag="find_prev" InputGestureText="Shift+F3" Click="Cmd"/>
                <MenuItem Header="_Replace..." Tag="replace" InputGestureText="Ctrl+H" Icon="{c:Ico replace}" Click="Cmd"/>
                <Separator/>
                <MenuItem Header="Find in F_iles..." Tag="find_files" InputGestureText="Ctrl+Shift+F" Icon="{c:Ico find_files}" Click="Cmd"/>
                <Separator/>
                <MenuItem Header="_Go To..." Tag="goto" InputGestureText="Ctrl+G" Icon="{c:Ico goto}" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiFocus" Header="F_ocused View" Tag="focus" InputGestureText="Ctrl+Alt+F" Icon="{c:Ico mark}" Click="Cmd"/>
            </MenuItem>
            <MenuItem Header="_View" SubmenuOpened="Menu_Opened">
                <MenuItem x:Name="MiToolbar" Header="_Toolbar" Tag="toggle_toolbar" Click="Cmd"/>
                <MenuItem x:Name="MiStatus" Header="_Status Bar" Tag="toggle_status" Click="Cmd"/>
                <MenuItem x:Name="MiConsole" Header="_Console" Tag="console" InputGestureText="Ctrl+`" Icon="{c:Ico terminal}" Click="Cmd"/>
                <MenuItem x:Name="MiMdPreview" Header="Markdown _Preview" Tag="md_preview" InputGestureText="Ctrl+Shift+V" Icon="{c:Ico preview}" Click="Cmd"/>
                <MenuItem x:Name="MiMdSync" Header="S_ync Preview Scrolling" Tag="md_sync" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiWrap" Header="_Word Wrap" Tag="wrap" InputGestureText="Alt+Z" Icon="{c:Ico wrap}" Click="Cmd"/>
                <MenuItem x:Name="MiLineNumbers" Header="_Line Numbers" Tag="toggle_lnum" Click="Cmd"/>
                <MenuItem x:Name="MiFolding" Header="Code _Folding" Tag="toggle_folding" Click="Cmd"/>
                <MenuItem x:Name="MiFoldAll" Header="Toggle _All Folds" Tag="fold" Icon="{c:Ico fold}" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiWhitespace" Header="Show W_hitespace" Tag="toggle_ws" Click="Cmd"/>
                <MenuItem x:Name="MiShowEol" Header="Show Line _Endings" Tag="toggle_eol" Click="Cmd"/>
                <MenuItem x:Name="MiLongLine" Header="Long Line _Marker" Tag="ruler" Icon="{c:Ico ruler}" Click="Cmd"/>
                <MenuItem Header="Long Line _Column..." Tag="ruler_col" Click="Cmd"/>
                <MenuItem x:Name="MiCurLine" Header="Highlight _Current Line" Tag="toggle_curline" Click="Cmd"/>
                <MenuItem x:Name="MiMarkOcc" Header="Mark _Occurrences" Tag="toggle_occ" Click="Cmd"/>
                <Separator/>
                <MenuItem Header="Zoom _In" Tag="zoom_in" InputGestureText="Ctrl++" Icon="{c:Ico zoom_in}" Click="Cmd"/>
                <MenuItem Header="Zoom _Out" Tag="zoom_out" InputGestureText="Ctrl+-" Icon="{c:Ico zoom_out}" Click="Cmd"/>
                <MenuItem Header="_Reset Zoom" Tag="zoom_reset" InputGestureText="Ctrl+0" Icon="{c:Ico zoom_reset}" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiTopmost" Header="Always on _Top" Tag="pin" InputGestureText="Alt+T" Icon="{c:Ico pin}" Click="Cmd"/>
            </MenuItem>
            <MenuItem Header="A_ppearance" SubmenuOpened="Menu_Opened">
                <MenuItem Header="_Customize Interface..." Tag="customize" InputGestureText="Ctrl+Alt+P" Icon="{c:Ico settings}" Click="Cmd"/>
                <MenuItem x:Name="MiPresets" Header="_Theme"/>
                <Separator/>
                <MenuItem Header="_Font..." Tag="font" Icon="{c:Ico font}" Click="Cmd"/>
                <MenuItem Header="_Secondary Font..." Tag="font2" Click="Cmd"/>
                <MenuItem x:Name="MiUse2nd" Header="_Use Secondary Font" Tag="toggle_2nd" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiScheme" Header="Syntax _Scheme"/>
                <MenuItem x:Name="MiAutoScheme" Header="_Auto-detect Scheme" Tag="toggle_autoscheme" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiTabWidth" Header="_Tab Width"/>
                <MenuItem x:Name="MiTabsSpaces" Header="_Indent with Spaces" Tag="toggle_tabspaces" Click="Cmd"/>
            </MenuItem>
            <MenuItem Header="_Settings" SubmenuOpened="Menu_Opened">
                <MenuItem x:Name="MiAutoIndent" Header="_Auto Indent" Tag="toggle_autoindent" Click="Cmd"/>
                <MenuItem x:Name="MiAutoComplete" Header="Auto _Completion" Tag="toggle_autocomplete" Click="Cmd"/>
                <MenuItem x:Name="MiRestoreSession" Header="Restore _Session on Start" Tag="toggle_session" Click="Cmd"/>
                <MenuItem x:Name="MiHotExit" Header="_Keep Unsaved Changes on Exit" Tag="toggle_hotexit" Click="Cmd"/>
                <Separator/>
                <MenuItem x:Name="MiInstant" Header="_Instant Start (stay ready in the background)" Tag="toggle_instant" Click="Cmd"/>
                <MenuItem x:Name="MiAutoStart" Header="Start with _Windows" Tag="toggle_autostart" Click="Cmd"/>
                <MenuItem x:Name="MiDetect" Header="_Detect External File Changes" Tag="toggle_detect" Click="Cmd"/>
                <MenuItem x:Name="MiRemember" Header="_Remember Recent Files" Tag="toggle_remember" Click="Cmd"/>
                <MenuItem x:Name="MiSaveOnExit" Header="_Save Settings on Exit" Tag="toggle_saveonexit" Click="Cmd"/>
                <Separator/>
                <MenuItem Header="Save Settings _Now" Tag="save_settings" Icon="{c:Ico settings}" Click="Cmd"/>
                <MenuItem Header="_Open Settings Folder" Tag="settings_folder" Click="Cmd"/>
                <MenuItem Header="R_eset Settings..." Tag="reset_settings" Click="Cmd"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" Tag="shortcuts" InputGestureText="F1" Click="Cmd"/>
                <Separator/>
                <MenuItem Header="_About Notepad9" Tag="about" Icon="{c:Ico about}" Click="Cmd"/>
            </MenuItem>
        </Menu>
        <Border x:Name="MenuLine" DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}"/>

        <!-- ================================================================ toolbar -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="{DynamicResource ToolbarBg}" MinHeight="27">
            <WrapPanel x:Name="ToolbarPanel" Margin="3,1,3,1" VerticalAlignment="Center">
                <Button x:Name="TbNew" Tag="new" Style="{StaticResource ToolButton}" Content="{c:Ico new}" ToolTip="New (Ctrl+N)" Click="Cmd"/>
                <Button Tag="window_new" Style="{StaticResource ToolButton}" Content="{c:Ico window_new}" ToolTip="New Window (Ctrl+Shift+N)" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <Button Tag="open" Style="{StaticResource ToolButton}" Content="{c:Ico open}" ToolTip="Open (Ctrl+O)" Click="Cmd"/>
                <Button x:Name="TbSave" Tag="save" Style="{StaticResource ToolButton}" Content="{c:Ico save}" ToolTip="Save (Ctrl+S)" Click="Cmd"/>
                <Button Tag="save_as" Style="{StaticResource ToolButton}" Content="{c:Ico save_as}" ToolTip="Save As (F12)" Click="Cmd"/>
                <Button x:Name="TbRecent" Tag="recent_menu" Style="{StaticResource ToolButton}" Content="{c:Ico recent}" ToolTip="Recent Files" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <Button x:Name="TbUndo" Tag="undo" Style="{StaticResource ToolButton}" Content="{c:Ico undo}" ToolTip="Undo (Ctrl+Z)" Click="Cmd"/>
                <Button x:Name="TbRedo" Tag="redo" Style="{StaticResource ToolButton}" Content="{c:Ico redo}" ToolTip="Redo (Ctrl+Y)" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <Button x:Name="TbCut" Tag="cut" Style="{StaticResource ToolButton}" Content="{c:Ico cut}" ToolTip="Cut (Ctrl+X)" Click="Cmd"/>
                <Button x:Name="TbCopy" Tag="copy" Style="{StaticResource ToolButton}" Content="{c:Ico copy}" ToolTip="Copy (Ctrl+C)" Click="Cmd"/>
                <Button x:Name="TbPaste" Tag="paste" Style="{StaticResource ToolButton}" Content="{c:Ico paste}" ToolTip="Paste (Ctrl+V)" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <Button x:Name="TbFind" Tag="find" Style="{StaticResource ToolButton}" Content="{c:Ico find}" ToolTip="Find (Ctrl+F)" Click="Cmd"/>
                <Button x:Name="TbReplace" Tag="replace" Style="{StaticResource ToolButton}" Content="{c:Ico replace}" ToolTip="Replace (Ctrl+H)" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <Button Tag="find_files" Style="{StaticResource ToolButton}" Content="{c:Ico find_files}" ToolTip="Find in Files (Ctrl+Shift+F)" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <ToggleButton x:Name="TbWrap" Tag="wrap" Style="{StaticResource ToolToggle}" Content="{c:Ico wrap}" ToolTip="Word Wrap (Alt+Z)" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <Button x:Name="TbFold" Tag="fold" Style="{StaticResource ToolButton}" Content="{c:Ico fold}" ToolTip="Toggle All Folds" Click="Cmd"/>
                <ToggleButton x:Name="TbFocus" Tag="focus" Style="{StaticResource ToolToggle}" Content="{c:Ico mark}" ToolTip="Focused View: show only lines containing the selection (Ctrl+Alt+F)" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <Button x:Name="TbFav" Tag="fav_menu" Style="{StaticResource ToolButton}" Content="{c:Ico star}" ToolTip="Favorites" Click="Cmd"/>
                <Button x:Name="TbAddFav" Tag="star_add" Style="{StaticResource ToolButton}" Content="{c:Ico star_add}" ToolTip="Add to Favorites" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <Button Tag="zoom_in" Style="{StaticResource ToolButton}" Content="{c:Ico zoom_in}" ToolTip="Zoom In (Ctrl++)" Click="Cmd"/>
                <Button Tag="zoom_reset" Style="{StaticResource ToolButton}" Content="{c:Ico zoom_reset}" ToolTip="Reset Zoom (Ctrl+0)" Click="Cmd"/>
                <Button Tag="zoom_out" Style="{StaticResource ToolButton}" Content="{c:Ico zoom_out}" ToolTip="Zoom Out (Ctrl+-)" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <ToggleButton x:Name="TbRuler" Tag="ruler" Style="{StaticResource ToolToggle}" Content="{c:Ico ruler}" ToolTip="Long Line Marker" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <ToggleButton x:Name="TbConsole" Tag="console" Style="{StaticResource ToolToggle}" Content="{c:Ico terminal}" ToolTip="Console (Ctrl+`)" Click="Cmd"/>
                <Button x:Name="TbRun" Tag="run" Style="{StaticResource ToolButton}" Content="{c:Ico run}" ToolTip="Run current file (F5)" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <ToggleButton x:Name="TbPin" Tag="pin" Style="{StaticResource ToolToggle}" Content="{c:Ico pin}" ToolTip="Always on Top (Alt+T)" Click="Cmd"/>
                <Control Style="{StaticResource ToolSeparator}"/>
                <Button Tag="exit" Style="{StaticResource ToolButton}" Content="{c:Ico exit}" ToolTip="Exit (Ctrl+Q)" Click="Cmd"/>
            </WrapPanel>
        </Border>

        <!-- ================================================================ status bar -->
        <Grid x:Name="StatusBar" DockPanel.Dock="Bottom" Height="29" Background="{DynamicResource StatusBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto" MinWidth="78"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatusClickField}" Tag="goto" MouseLeftButtonUp="Status_Click" ToolTip="Go To (Ctrl+G)">
                <TextBlock x:Name="SbLn" Style="{StaticResource StatusText}" Text="Ln  1 / 1"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatusClickField}" Tag="goto" MouseLeftButtonUp="Status_Click" ToolTip="Go To (Ctrl+G)">
                <TextBlock x:Name="SbCol" Style="{StaticResource StatusText}" Text="Col  1 / 0"/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatusField}">
                <TextBlock x:Name="SbInfo" Style="{StaticResource StatusText}"/>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource StatusClickField}" Tag="eval_copy" MouseLeftButtonUp="Status_Click" ToolTip="Result of the selected expression. Click to copy.">
                <TextBlock x:Name="SbEval" Style="{StaticResource StatusText}" Text="Eval  --"/>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource StatusField}" ToolTip="Selected characters">
                <TextBlock x:Name="SbSel" Style="{StaticResource StatusText}" Text="Sel  --"/>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource StatusField}" ToolTip="Selected lines">
                <TextBlock x:Name="SbSln" Style="{StaticResource StatusText}" Text="SLn  --"/>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource StatusField}" ToolTip="Occurrences of the selection">
                <TextBlock x:Name="SbOcc" Style="{StaticResource StatusText}" Text="Occ  -/-"/>
            </Border>
            <Border Grid.Column="7" Style="{StaticResource StatusField}" ToolTip="File size with the current encoding">
                <TextBlock x:Name="SbBytes" Style="{StaticResource StatusText}" Text="0 bytes"/>
            </Border>
            <Border Grid.Column="8" Style="{StaticResource StatusClickField}" Tag="enc_menu" MouseLeftButtonUp="Status_Click" ToolTip="Encoding">
                <TextBlock x:Name="SbEnc" Style="{StaticResource StatusText}" Text="Unicode (UTF-8)"/>
            </Border>
            <Border Grid.Column="9" Style="{StaticResource StatusClickField}" Tag="eol_menu" MouseLeftButtonUp="Status_Click" ToolTip="Line endings">
                <TextBlock x:Name="SbEol" Style="{StaticResource StatusText}" Text="CR+LF"/>
            </Border>
            <Border Grid.Column="10" Style="{StaticResource StatusClickField}" Tag="ins" MouseLeftButtonUp="Status_Click" ToolTip="Insert / Overwrite (Insert)">
                <TextBlock x:Name="SbIns" Style="{StaticResource StatusText}" Text="INS"/>
            </Border>
            <Border Grid.Column="11" Style="{StaticResource StatusClickField}" Tag="toggle_2nd" MouseLeftButtonUp="Status_Click" ToolTip="Standard / secondary font">
                <TextBlock x:Name="SbStd" Style="{StaticResource StatusText}" Text="STD"/>
            </Border>
            <Border Grid.Column="12" Style="{StaticResource StatusClickField}" BorderThickness="0" Tag="scheme_menu" MouseLeftButtonUp="Status_Click" ToolTip="Syntax scheme">
                <TextBlock x:Name="SbScheme" Style="{StaticResource StatusText}" Text="Text Files"/>
            </Border>
        </Grid>

        <!-- ================================================================ editor -->
        <Grid x:Name="WorkArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="80"/>
                <RowDefinition x:Name="ConsoleSplitRow" Height="0"/>
                <RowDefinition x:Name="ConsoleRow" Height="0"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <!-- tabs -->
                <Border x:Name="TabBar" DockPanel.Dock="Top" Background="{DynamicResource TabBarBg}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource TabBarButton}" ToolTip="All tabs" Click="TabList_Click">
                                <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TabText}" StrokeThickness="1.4"/>
                            </Button>
                        </StackPanel>
                        <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="TabScroller_PreviewMouseWheel" Focusable="False">
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl x:Name="TabStrip" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TabRoot" Background="{DynamicResource TabBg}" Height="30" MinWidth="90"
                                                    MaxWidth="{DynamicResource TabMaxWidth}" ToolTip="{Binding ToolTip}"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"
                                                    MouseDown="Tab_MouseDown" MouseUp="Tab_MouseUp" MouseMove="Tab_MouseMove">
                                                <Grid>
                                                    <Border x:Name="Accent" Height="2" VerticalAlignment="Top" Background="{DynamicResource TabAccent}" Visibility="Hidden"/>
                                                    <DockPanel Margin="10,1,5,0">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}" Margin="6,0,0,0"
                                                                Visibility="{DynamicResource TabCloseVisibility}" Click="TabClose_Click" ToolTip="Close (Ctrl+W)"/>
                                                        <TextBlock x:Name="Title" Text="{Binding Title}" Foreground="{DynamicResource TabText}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,1"/>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource TabHoverBg}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource TabActiveBg}"/>
                                                    <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TabActiveText}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                    <Setter TargetName="Title" Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource TabBarButton}" ToolTip="New tab (Ctrl+T)" Tag="new" Click="Cmd">
                                    <Path Data="M5,0 V10 M0,5 H10" Stroke="{DynamicResource TabText}" StrokeThickness="1.3"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <!-- markdown formatting bar (only for Markdown files) -->
                <Border x:Name="MdBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" MinHeight="27">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                            <ToggleButton x:Name="TbMdSync" Tag="md_sync" Style="{StaticResource ToolToggle}" Width="Auto" ToolTip="Scroll the preview together with the text" Click="Cmd">
                                <TextBlock x:Name="TbMdSyncText" Text="Sync" Foreground="#DEDEDE" Margin="6,0,6,1"/>
                            </ToggleButton>
                            <ToggleButton x:Name="TbMdPreview" Tag="md_preview" Style="{StaticResource ToolToggle}" Content="{c:Ico preview}" ToolTip="Show / hide preview (Ctrl+Shift+V)" Click="Cmd"/>
                        </StackPanel>
                        <WrapPanel x:Name="MdBarPanel" Margin="3,1,3,1" VerticalAlignment="Center">
                            <Button Tag="md_bold" Style="{StaticResource ToolButton}" Content="{c:Ico md_bold}" ToolTip="Bold (Ctrl+B)" Click="Cmd"/>
                            <Button Tag="md_italic" Style="{StaticResource ToolButton}" Content="{c:Ico md_italic}" ToolTip="Italic (Ctrl+I)" Click="Cmd"/>
                            <Button Tag="md_strike" Style="{StaticResource ToolButton}" Content="{c:Ico md_strike}" ToolTip="Strikethrough" Click="Cmd"/>
                            <Button Tag="md_heading" Style="{StaticResource ToolButton}" Content="{c:Ico md_heading}" ToolTip="Heading: none / # / ## / ### (Ctrl+Shift+H)" Click="Cmd"/>
                            <Control Style="{StaticResource ToolSeparator}"/>
                            <Button Tag="md_code" Style="{StaticResource ToolButton}" Content="{c:Ico md_code}" ToolTip="Inline code" Click="Cmd"/>
                            <Button Tag="md_codeblock" Style="{StaticResource ToolButton}" Content="{c:Ico md_codeblock}" ToolTip="Code block" Click="Cmd"/>
                            <Control Style="{StaticResource ToolSeparator}"/>
                            <Button Tag="md_link" Style="{StaticResource ToolButton}" Content="{c:Ico md_link}" ToolTip="Link (Ctrl+K)" Click="Cmd"/>
                            <Button Tag="md_image" Style="{StaticResource ToolButton}" Content="{c:Ico md_image}" ToolTip="Insert image..." Click="Cmd"/>
                            <Control Style="{StaticResource ToolSeparator}"/>
                            <Button Tag="md_ul" Style="{StaticResource ToolButton}" Content="{c:Ico md_ul}" ToolTip="Bullet list" Click="Cmd"/>
                            <Button Tag="md_ol" Style="{StaticResource ToolButton}" Content="{c:Ico md_ol}" ToolTip="Numbered list" Click="Cmd"/>
                            <Button Tag="md_task" Style="{StaticResource ToolButton}" Content="{c:Ico md_task}" ToolTip="Task list" Click="Cmd"/>
                            <Button Tag="md_quote" Style="{StaticResource ToolButton}" Content="{c:Ico md_quote}" ToolTip="Quote" Click="Cmd"/>
                            <Button Tag="md_table" Style="{StaticResource ToolButton}" Content="{c:Ico md_table}" ToolTip="Table" Click="Cmd"/>
                            <Button Tag="md_hr" Style="{StaticResource ToolButton}" Content="{c:Ico md_hr}" ToolTip="Horizontal rule" Click="Cmd"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <Grid x:Name="EditorGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="EditorCol" Width="*" MinWidth="120"/>
                        <ColumnDefinition x:Name="PreviewSplitCol" Width="0"/>
                        <ColumnDefinition x:Name="PreviewCol" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="EditorBackdrop" Background="{DynamicResource EditorBg}"/>
                    <Border x:Name="EditorBackImage" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <ContentControl x:Name="EditorHost" Focusable="False" IsTabStop="False"/>
                    <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource SplitterBg}"
                                  Focusable="False" Visibility="Collapsed"/>
                    <c:MarkdownPreview x:Name="Preview" Grid.Column="2" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
            <GridSplitter x:Name="ConsoleSplitter" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource SplitterBg}"
                          Focusable="False" Visibility="Collapsed"/>
            <ContentControl x:Name="TermHost" Grid.Row="2" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
        </Grid>
    </DockPanel>
    </Grid>
</c:N9Window>
