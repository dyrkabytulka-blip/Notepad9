<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- only for the tray icon; loaded when Notepad9 goes to the background -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Notepad9</AssemblyName>
    <RootNamespace>Notepad9</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Notepad9</Product>
    <Copyright>Copyright (c) 2026 Notepad9 authors. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- fast start -->
    <StartupObject>Notepad9.Program</StartupObject>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- DPI awareness stays in app.manifest: it is what the WPF window uses -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Program.Main starts WPF itself, after the single-instance check -->
    <ApplicationDefinition Remove="App.xaml" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
