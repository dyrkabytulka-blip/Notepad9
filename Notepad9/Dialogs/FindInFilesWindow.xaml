<c:N9Window x:Class="Notepad9.Dialogs.FindInFilesWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="clr-namespace:Notepad9.Controls"
            Title="Find in Files" Width="720" Height="480" MinWidth="480" MinHeight="300"
            ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="14,10,14,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Find what:" Style="{StaticResource DialogLabel}"/>
        <TextBox x:Name="FindBox" Grid.Column="1" Margin="0,2"/>
        <Button x:Name="SearchBtn" Grid.Column="2" Content="_Search" IsDefault="True" Margin="8,2,0,2" Click="Search_Click"/>

        <TextBlock Grid.Row="1" Text="Folder:" Style="{StaticResource DialogLabel}"/>
        <TextBox x:Name="FolderBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,2"/>
        <Button Grid.Row="1" Grid.Column="2" Content="_Browse..." Margin="8,4,0,2" Click="Browse_Click"/>

        <TextBlock Grid.Row="2" Text="File types:" Style="{StaticResource DialogLabel}"/>
        <TextBox x:Name="MaskBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,2" ToolTip="Separate masks with ; e.g. *.cs;*.xaml"/>

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,8">
            <CheckBox x:Name="MatchCase" Content="Match _case" Margin="0,0,18,0"/>
            <CheckBox x:Name="UseRegex" Content="_Regular expression" Margin="0,0,18,0"/>
            <CheckBox x:Name="Subfolders" Content="Include sub_folders" IsChecked="True"/>
        </StackPanel>

        <ListBox x:Name="Results" Grid.Row="4" Grid.ColumnSpan="3" FontFamily="Consolas" FontSize="12.5"
                 MouseDoubleClick="Results_DoubleClick" KeyDown="Results_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Display, Mode=OneWay}" Foreground="#9CDCFE"/><Run Text="{Binding LineText, Mode=OneWay}" Foreground="#DEDEDE"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="Status" Grid.Row="5" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="{DynamicResource TextDim}"
                   Text="Double-click a result to open it." TextTrimming="CharacterEllipsis"/>
    </Grid>
</c:N9Window>
