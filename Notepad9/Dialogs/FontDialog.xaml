<c:N9Window x:Class="Notepad9.Dialogs.FontDialog"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="clr-namespace:Notepad9.Controls"
            Title="Font" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
            ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="16,12,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Font:" Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
        <TextBlock Grid.Column="2" Text="Size:" Style="{StaticResource DialogLabel}" Margin="0,0,0,4"/>
        <TextBox x:Name="FamilyBox" Grid.Row="1" Margin="0,0,0,4" TextChanged="FamilyBox_TextChanged"/>
        <TextBox x:Name="SizeBox" Grid.Row="1" Grid.Column="2" Margin="0,0,0,4" TextChanged="SizeBox_TextChanged"/>
        <ListBox x:Name="Families" Grid.Row="2" SelectionChanged="Families_SelectionChanged"/>
        <ListBox x:Name="Sizes" Grid.Row="2" Grid.Column="2" SelectionChanged="Sizes_SelectionChanged"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="Bold" Content="_Bold" Margin="0,0,18,0" Checked="Style_Changed" Unchecked="Style_Changed"/>
            <CheckBox x:Name="Italic" Content="_Italic" Checked="Style_Changed" Unchecked="Style_Changed"/>
        </StackPanel>
        <Border Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0" Height="64" Background="#141414"
                BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="2">
            <TextBlock x:Name="Preview" Text="AaBbYyZz 0123 Привет {}[];" VerticalAlignment="Center"
                       HorizontalAlignment="Center" Foreground="#DEDEDE"/>
        </Border>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</c:N9Window>
